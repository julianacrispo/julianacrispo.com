---
import Layout from "../layouts/Layout.astro";
import { NewsletterPage } from "@/components/pages/newsletter";
import { SITE_CONFIG } from "@/site-config";

export const prerender = true;
---

<Layout
  title={SITE_CONFIG.name}
  description={SITE_CONFIG.description}
  image="/five-minutes.jpg"
  imageAlt="Juliana Crispo"
>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </Fragment>
  <NewsletterPage client:load />
</Layout>
