---
import Layout from "../layouts/Layout.astro";
import { NewsletterPage } from "@/components/pages/newsletter";

export const prerender = true;

const description =
  "3-Bullet Thursday: every Thursday, Juliana Crispo sends an exclusive email with the 3 coolest things she's found (or explored) that week.";
---

<Layout title="Juliana Crispo · 3-Bullet Thursday" description={description}>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Hanken+Grotesk:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </Fragment>
  <NewsletterPage client:load />
</Layout>
